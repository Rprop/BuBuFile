<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BuBuFile.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_on_primary_container</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_on_secondary</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/md_theme_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surface_container_high</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="android:colorBackground">@color/md_theme_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BuBuFile.MaterialAlertDialog</item>
        <item name="materialCardViewStyle">@style/Widget.BuBuFile.CardView</item>
        <item name="checkboxStyle">@style/Widget.BuBuFile.CheckBox</item>
    </style>

    <style name="Theme.BuBuFile" parent="Theme.BuBuFile.Base">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="ThemeOverlay.BuBuFile.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="Widget.BuBuFile.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.BuBuFile.TitleMedium</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.BuBuFile.Button" parent="Widget.Material3.Button" />

    <style name="Widget.BuBuFile.Button.TextButton" parent="Widget.Material3.Button.TextButton" />

    <style name="Widget.BuBuFile.Button.TonalButton" parent="Widget.Material3.Button.TonalButton" />

    <style name="Widget.BuBuFile.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.BuBuFile.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.BuBuFile.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.BuBuFile.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.BuBuFile.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.BuBuFile.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.BuBuFile.DialogPathTitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ShapeAppearance.BuBuFile.VideoThumbnail" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/card_corner_radius</item>
    </style>

    <style name="Theme.BuBuFile.Transparent" parent="Theme.BuBuFile">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
