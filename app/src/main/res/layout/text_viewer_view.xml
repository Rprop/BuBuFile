<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.BuBuFile.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        app:menu="@menu/text_viewer_menu"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
        android:id="@+id/vertical_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <HorizontalScrollView
                android:id="@+id/horizontal_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/content_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/line_number_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:lineSpacingMultiplier="1.2"
                        android:paddingEnd="12dp"
                        android:textAppearance="@style/TextAppearance.BuBuFile.LabelLarge"
                        android:textIsSelectable="false"
                        android:textSize="11sp"
                        app:emojiCompatEnabled="false" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/content_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingMultiplier="1.2"
                        android:textAppearance="@style/TextAppearance.BuBuFile.BodyMedium"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        app:emojiCompatEnabled="false" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:id="@+id/wrap_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:visibility="gone" />
        </FrameLayout>
    </ScrollView>
</RelativeLayout>
