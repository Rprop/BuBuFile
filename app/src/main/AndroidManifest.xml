<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:ignore="PhotoAndVideoPolicy" />

    <application
        android:name="rprop.app.BuBuFileApplication"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.BuBuFile"
        tools:ignore="GoogleAppIndexingWarning, LockedOrientationActivity, DiscouragedApi">
        <activity
            android:name="rprop.app.video.select.VideoSelectActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="rprop.app.video.play.VideoPlayActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="rprop.app.video.trim.VideoTrimActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="rprop.app.video.concat.VideoConcatActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="rprop.app.ui.FileChooserActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BuBuFile.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name="rprop.app.ui.ThemeShortcutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BuBuFile.Transparent">
            <intent-filter>
                <action android:name="rp.file.action.SET_THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="rprop.app.txt.TextViewActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="rprop.app.img.ImageViewActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>